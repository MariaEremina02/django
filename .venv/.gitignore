# created by virtualenv automatically
*# Виртуальное окружение
.venv/
env/
venv/
ENV/

# Скомпилированный Python-код
**/__pycache__/
*.py[cod]
*$py.class

# База данных (если используете SQLite)
*.sqlite3

# Секретные данные и настройки
.env
db.sqlite3
local_settings.py

# Медиа и статика (пользовательские загрузки обычно не хранят в Git)
media/
staticfiles/

# Настройки PyCharm
.idea/
*.iml

# Логи
*.log

# Прочее
.DS_Store
